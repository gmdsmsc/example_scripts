from pathlib import Path
from datetime import datetime
import os

ROOT = Path("//network/home")
IGNORE_DIRS = {str(ROOT / d) for d in ["Folder1","Folder2","Folder3"]}
IGNORE_EXT = {".db"}
IGNORE_CHARS = {"~"}

def walk(root):
    stack=[str(root)]
    while stack:
        p=stack.pop()
        try:
            with os.scandir(p) as it:
                for e in it:
                    ep=e.path
                    if e.is_dir(follow_symlinks=False):
                        if ep not in IGNORE_DIRS:
                            stack.append(ep)
                    else:
                        yield ep
        except: pass

def meta(root, fpath):
    name=os.path.basename(fpath)
    if any(c in name for c in IGNORE_CHARS): return
    ext=os.path.splitext(name)[1].lower()
    if ext in IGNORE_EXT: return

    p=Path(fpath)
    m=datetime.fromtimestamp(p.stat().st_mtime).strftime("%Y-%m-%d %H:%M:%S")
    return (
        str(p.parent),
        name,
        ext,
        m,
        datetime.today().strftime("%d/%m/%y"),
        p.parent.relative_to(root).as_posix()
    )

if __name__=="__main__":
    with open("output.csv","w",encoding="utf-8") as w:
        w.write(",,Folder,File Name,Extension,Date Modified,Date,FolderName\n")
        for i,f in enumerate(walk(ROOT)):
            m=meta(ROOT,f)
            if m: w.write(f"{i}," + ",".join(m) + "\n")
